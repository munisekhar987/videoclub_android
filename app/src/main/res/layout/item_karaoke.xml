<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_margin="4dp"
    android:background="@drawable/karaoke_item_background">

    <TextView
        android:id="@+id/index_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.1"
        android:background="@drawable/index_background"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:focusable="true"
        android:clickable="true"/>

    <TextView
        android:id="@+id/karaoke_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.6"
        android:background="@drawable/normal_background"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusRight="@id/record_button"/>

    <Button
        android:id="@+id/record_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="@drawable/normal_button"
        android:text="Record"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginStart="4dp"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusLeft="@id/karaoke_name"/>
</LinearLayout>